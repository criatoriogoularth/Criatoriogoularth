# Copie este arquivo para ".env" e preencha. NUNCA suba o .env de verdade para o GitHub.

# --- BANCO MESTRE (clientes, logins, planos, convites) ---
# Pode ser um projeto do Neon só para isso.
MASTER_DATABASE_URL=postgresql://usuario:senha@host/aviari_mestre

# --- SEGREDOS (gere cada um com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=troque-por-um-valor-aleatorio-longo-e-secreto
# APP_KEY cifra o endereço do banco de cada cliente e os CPFs. GUARDE UMA CÓPIA: sem ela esses dados não voltam.
APP_KEY=troque-por-outro-valor-aleatorio-com-32-ou-mais-caracteres

# --- ENDEREÇOS ---
# Seu domínio base (sem http). Os sites ficam em NOME.dominio. Deixe vazio enquanto não tiver domínio.
BASE_DOMAIN=
# Endereço do sistema (usado nos links de convite). Ex.: https://seu-app.onrender.com
APP_URL=
# Criatório que aparece quando não dá para saber de qual é o site (ex.: o seu, durante a migração). Opcional.
DEFAULT_TENANT_SLUG=

# --- COMO CRIAR O BANCO DE UM CLIENTE NOVO ---
# Opção A (servidor próprio/VPS): um usuário do Postgres com permissão CREATE DATABASE.
#   Cada cliente novo ganha um banco "aviari_NOME" automaticamente.
ADMIN_DATABASE_URL=
# Opção B (Neon/Render grátis): deixe vazio e, ao criar o convite no painel do dono,
#   cole a URL de um banco vazio que você criou no Neon (um projeto por cliente).

# --- E-MAIL (confirmação de cadastro, recuperar senha, avisos de vencimento) ---
# Preencha UM dos dois. Sem nenhum, funciona em "modo de teste": os e-mails aparecem no painel do dono.
RESEND_API_KEY=
EMAIL_FROM=Aviari <nao-responda@seudominio.com.br>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# false = não mandar avisos de vencimento automaticamente (use scripts/avisos.js no cron)
AVISOS_AUTOMATICOS=true

# --- PAGAMENTOS (opcional): token do webhook do Asaas ---
ASAAS_WEBHOOK_TOKEN=

# E-mail do Let's Encrypt (usado pelo Caddy no servidor)
ACME_EMAIL=

PORT=3000
FRONTEND_ORIGIN=

# "false" desliga SSL na conexão com o Postgres (só para Postgres local sem SSL)
PGSSL=true

# Limites para economizar memória/conexões (valores padrão)
# MAX_TENANT_POOLS=25
# TENANT_POOL_MAX=3
